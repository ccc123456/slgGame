  "scripts": {
    "gen-proto": "npx protoc --plugin=./node_modules/.bin/protoc-gen-ts_proto.cmd --ts_proto_out=./src --ts_proto_opt=esModuleInterop=true ./proto/Message_0_1000_player.proto",
